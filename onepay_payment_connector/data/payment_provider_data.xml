<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="redirect_form" name="OnePay Redirect Form">
        <form t-att-action="api_url" method="get" target="_self">
        </form>
    </template>

    <record id="payment_provider_onepay" model="payment.provider">
        <field name="name">OnePay</field>
        <field name="code">onepay</field>
        <field name="is_live">False</field>
        <field name="redirect_form_view_id" ref="onepay_payment_connector.redirect_form"/>
        <field name="image_128" type="bytes" file="onepay_payment_connector/static/description/icon.png"/>
    </record>

    <record id="payment_method_onepay" model="payment.method">
        <field name="name">OnePay</field>
        <field name="code">onepay</field>
        <field name="provider_id" ref="onepay_payment_connector.payment_provider_onepay"/>
        <field name="sequence">10</field>
        <field name="active">True</field>
        <field name="image" type="bytes" file="onepay_payment_connector/static/description/icon.png"/>
    </record>

</odoo>
