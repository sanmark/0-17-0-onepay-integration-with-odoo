<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_onepay" model="ir.ui.view">
        <field name="name">payment.provider.form.onepay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group string="OnePay Credentials" invisible="code != 'onepay'">
                    <field name="onepay_app_id"
                           required="code == 'onepay'"/>
                    <field name="onepay_app_token"
                           required="code == 'onepay'"/>
                    <field name="onepay_hash_salt"
                           required="code == 'onepay'"/>
                    <field name="onepay_api_base_url"
                           required="code == 'onepay'"/>
                </group>
            </xpath>

            <xpath expr="//page[@name='configuration']" position="inside">
                <group string="OnePay Callback URL" invisible="code != 'onepay'">
                    <div class="alert alert-info" role="status" colspan="2">
                        Add this URL in the OnePay merchant portal APP callback setting:
                        <br/>
                        <strong>/payment/onepay/webhook</strong>
                        <br/>
                        Full example:
                        <strong>https://your-domain.com/payment/onepay/webhook</strong>
                    </div>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
